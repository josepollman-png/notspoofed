# Every value here has a working default in docker-compose.yml, so `docker compose
# up -d` runs without a .env at all. Copy this to .env only to change something:
#
#   cp .env.example .env
#
# docker-compose.stack.yml is stricter — it expects MAILCHECK_SITE_URL and
# MAILCHECK_STATS_TOKEN to be set explicitly.

# Host port to publish the site on.
MAILCHECK_PORT=3000

# Public URL the site is served on, used for canonical links and og:url. Set this
# once a real domain points at the deployment; a wrong value is worse than the
# default, since it emits canonical tags pointing at someone else's site.
MAILCHECK_SITE_URL=http://localhost:3000

# Shared secret guarding /stats, which reports aggregate usage counters. Must be at
# least 16 characters or the route 404s. Empty leaves the route off, which is the
# right state unless you specifically want it.
#
# Generate with: head -c 24 /dev/urandom | base64 | tr -d '/+=' | head -c 32
MAILCHECK_STATS_TOKEN=

# Optional analytics via a self-hosted Umami (https://umami.is). Page views are sent
# from the server, so the site keeps its "no client-side JavaScript" property. Both
# must be set or the integration is a no-op.
#
# The website ID comes from Umami: Settings → Websites → Edit → Website ID.
MAILCHECK_UMAMI_URL=
MAILCHECK_UMAMI_WEBSITE_ID=
