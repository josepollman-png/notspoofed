---
import { getEntry, render } from 'astro:content';
import Research from '../layouts/Research.astro';
import { absoluteUrl } from '../lib/site.js';

const entry = (await getEntry('research', 'dmarc-adoption-statistics'))!;
const { Content } = await render(entry);

const URL_ = absoluteUrl('/dmarc-adoption-statistics');

/**
 * Article + Dataset + FAQPage, per the source file's schema note.
 *
 * The Dataset node points at the same @id as the dataset page rather than redeclaring the
 * distribution, so a consumer that reads both pages resolves one dataset and not two
 * competing descriptions of the same file.
 */
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: 'DMARC Adoption Statistics (2026)',
      description: entry.data.description,
      datePublished: '2026-08-14',
      dateModified: '2026-09-03',
      author: { '@type': 'Organization', name: 'notspoofed.com', url: absoluteUrl('/') },
      publisher: { '@type': 'Organization', name: 'notspoofed.com', url: absoluteUrl('/') },
      mainEntityOfPage: URL_,
      isBasedOn: absoluteUrl('/research/yc-email-spoofing-study'),
    },
    {
      '@type': 'Dataset',
      '@id': absoluteUrl('/research/yc-dmarc-dataset#dataset'),
      name: 'DMARC posture of 6,157 Y Combinator companies',
      description:
        'DMARC policy, SPF presence and MX status for 6,157 unique Y Combinator company domains, with batch and industry labels.',
      url: absoluteUrl('/research/yc-dmarc-dataset'),
      license: 'https://creativecommons.org/licenses/by/4.0/',
      creator: { '@type': 'Organization', name: 'notspoofed.com', url: absoluteUrl('/') },
      datePublished: '2026-08-14',
      dateModified: '2026-09-03',
      temporalCoverage: '2026-08-14/2026-09-03',
      measurementTechnique:
        'Passive public DNS resolution of _dmarc TXT, SPF TXT and MX records',
      distribution: {
        '@type': 'DataDownload',
        encodingFormat: 'text/csv',
        contentUrl: absoluteUrl('/data/yc-dmarc-2026-09.csv'),
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'What percentage of companies use DMARC?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'In a September 2026 scan of 6,157 Y Combinator company domains, 28.6% published no DMARC record at all. Publishing one is not the same as being protected: a further 31.8% were at p=none, which reports forged mail but still delivers it. Only 39.5% were at enforcement — p=quarantine or p=reject.',
          },
        },
        {
          '@type': 'Question',
          name: 'What is a good DMARC adoption rate?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Adoption is the wrong measure — enforcement is the one that matters. A domain at p=none has adopted DMARC and is still fully spoofable. Against this benchmark, 39.5% of companies scanned were at p=quarantine or p=reject, and 17.1% at p=reject.',
          },
        },
        {
          '@type': 'Question',
          name: 'How many companies use p=reject?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: '17.1% — 1,034 of the 6,049 domains conclusively classified in the September 2026 scan. p=reject is the only policy that fully stops a forged message showing your exact From: address.',
          },
        },
      ],
    },
  ],
};
---

<Research entry={entry} schema={schema}>
  <Content />
</Research>
