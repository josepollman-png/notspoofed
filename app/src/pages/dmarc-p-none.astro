---
import { getEntry, render } from 'astro:content';
import Research from '../layouts/Research.astro';
import { absoluteUrl } from '../lib/site.js';

const entry = (await getEntry('research', 'dmarc-p-none'))!;
const { Content } = await render(entry);

const URL_ = absoluteUrl('/dmarc-p-none');

/**
 * Article + FAQPage + HowTo, per the source file's schema note. The HowTo mirrors the
 * six-step migration section exactly — same order, same steps, no invented detail.
 */
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: 'What Does DMARC p=none Actually Mean?',
      description: entry.data.description,
      datePublished: '2026-08-14',
      author: { '@type': 'Organization', name: 'notspoofed.com', url: absoluteUrl('/') },
      publisher: { '@type': 'Organization', name: 'notspoofed.com', url: absoluteUrl('/') },
      mainEntityOfPage: URL_,
      isBasedOn: absoluteUrl('/research/yc-email-spoofing-study'),
    },
    {
      '@type': 'HowTo',
      name: 'Move a domain from DMARC p=none to enforcement',
      description:
        'The six steps from a monitoring-only DMARC record to p=reject, without blocking your own legitimate mail.',
      totalTime: 'P1M',
      step: [
        {
          '@type': 'HowToStep',
          position: 1,
          name: 'Collect reports for 2–4 weeks',
          text: 'Feed the rua address into any DMARC report parser; raw XML is not worth reading by hand.',
        },
        {
          '@type': 'HowToStep',
          position: 2,
          name: 'Inventory every legitimate sender',
          text: 'Build the list from the reports, not from memory.',
        },
        {
          '@type': 'HowToStep',
          position: 3,
          name: 'Fix alignment for each',
          text: 'Usually a custom return-path (SPF alignment) or a DKIM key published on your domain. Your vendors document this.',
        },
        {
          '@type': 'HowToStep',
          position: 4,
          name: 'Confirm your own mail passes',
          text: 'Check that aligned SPF or DKIM passes across all of your senders.',
        },
        {
          '@type': 'HowToStep',
          position: 5,
          name: 'Move to p=quarantine',
          text: 'Watch the reports for two weeks; failures now go to spam, which is recoverable.',
        },
        {
          '@type': 'HowToStep',
          position: 6,
          name: 'Move to p=reject',
          text: 'Done. This is the step where protection begins.',
        },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: [
        {
          '@type': 'Question',
          name: 'Does p=none protect against spoofing?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'No. p=none means monitor only. Receiving servers check whether a message really came from your domain, send you a report about what they found, and then deliver the message either way — including the forged ones. A message forging your exact From: address arrives in your customer’s inbox looking legitimate.',
          },
        },
        {
          '@type': 'Question',
          name: 'Is p=none better than no DMARC?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'For your visibility, yes — it is the correct first step, and skipping it is how people break their own email. For your exposure, no. To an attacker, p=none and no DMARC record are the same target.',
          },
        },
        {
          '@type': 'Question',
          name: 'How long should I stay at p=none?',
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'Two to four weeks of report collection is normally enough to inventory your legitimate senders. Most domains can complete the whole migration to p=reject in a month; the work is in finding the senders and fixing their alignment, not in the policy change itself.',
          },
        },
        {
          '@type': 'Question',
          name: "What's the difference between p=none and p=reject?",
          acceptedAnswer: {
            '@type': 'Answer',
            text: 'At p=none a forged message is delivered to the inbox and reported to you, so your exposure is unchanged. At p=reject it is refused at the SMTP layer, which closes the exposure. p=quarantine sits between them, delivering forged mail to the spam folder.',
          },
        },
      ],
    },
  ],
};
---

<Research entry={entry} schema={schema}>
  <Content />
</Research>
