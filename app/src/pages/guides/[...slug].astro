---
/**
 * The old guide URLs, kept alive as permanent redirects.
 *
 * Guides used to live at `/guides/<slug>/`, with a trailing slash, while the Next.js
 * application on the same hostname served its own guides at `/guide/<slug>` without
 * one. Two schemes differing by one letter and one slash is not a cosmetic problem: a
 * reader cannot tell which they are on, an internal link written from memory 404s, and
 * every page that got linked both ways split its own signals.
 *
 * `/guide/<slug>` won because the pages that already rank are on that side, and the
 * cheapest migration is the one that does not move ranking URLs.
 *
 * Astro's `trailingSlash: 'ignore'` also served `/guides/<slug>` and `/guides/<slug>/`
 * as two live URLs with one canonical between them, which is the duplicate this file
 * ends: both forms now answer 301 and there is exactly one URL per guide.
 *
 * 301 rather than a canonical tag alone. A canonical is a hint a search engine may
 * decline; a redirect is not, and it also carries any links already pointing at the old
 * form. Keep this route indefinitely — the old URLs are in Search Console, in llms.txt
 * copies and in whatever links exist.
 */
import { getEntry } from 'astro:content';

const slug = Astro.params.slug?.replace(/\/+$/, '') ?? '';

if (!slug) {
  return Astro.redirect('/guides', 301);
}

/*
 * Only real guides redirect. This used to forward any slug at all, so a mistyped or
 * invented /guides/<x> answered 301 into a 404 — a redirect to nowhere, which a
 * crawler has to follow to discover it was never there. An unknown slug now 404s
 * where it stands.
 *
 * "Real" is the content collection. Git history confirms no guide has ever been
 * deleted or renamed, so every slug that was ever published under /guides/ is still
 * in it; scripts/check-redirects.mjs replays that history against production. If a
 * guide is ever retired, give it an explicit target here rather than letting it 404.
 */
const guide = await getEntry('guides', slug);
if (!guide) {
  return new Response('Guide not found', { status: 404 });
}

return Astro.redirect(`/guide/${guide.id}`, 301);
---
