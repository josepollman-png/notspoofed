  h2 { margin-top: 40px; }
  p, li { max-width: 68ch; }
  ul { padding-left: 20px; }
  li { margin-bottom: 8px; }
  dt { font-weight: 600; margin-top: 22px; }
  dd { margin: 6px 0 0; color: var(--muted); max-width: 68ch; }
  code {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1px 5px;
    border-radius: 4px;
  }
</style>
