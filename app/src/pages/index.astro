---
import { getCollection } from 'astro:content';
import DomainForm from '../components/DomainForm.astro';
import Base from '../layouts/Base.astro';
import { BOUNCE_GUIDES, absoluteUrl } from '../lib/site.js';
import { RATE_LIMIT } from '../lib/ratelimit.js';

/**
 * Read from the collection rather than a hand-written list. The list was hardcoded and
 * silently went stale the moment two guides were added — they were live, in the sitemap
 * and on /guides, but invisible from the page that gets the most traffic.
 *
 * Only the first few are shown, so the landing page does not turn into a directory as
 * the collection grows. `order` is the editorial ranking, so the cut is deliberate
 * rather than alphabetical, and everything below it is one click away.
 */
const FEATURED = 8;

/**
 * Always on the home page, whatever their `order`. Both answer questions people search
 * in volume — which DKIM selector a domain uses, and why DMARC fails when SPF passes —
 * and both ranked well below the editorial cut, so the most authoritative page on the
 * site never linked to either. Listed first, then the editorial ranking fills the rest.
 */
const PINNED = ['dkim-selectors', 'dmarc-fails-when-spf-passes'];

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const featured = [
  ...PINNED.map((id) => guides.find((g) => g.id === id)).filter((g) => g !== undefined),
  ...guides.filter((g) => !PINNED.includes(g.id)),
].slice(0, FEATURED);

/**
 * Site-level schema. The guide pages have carried TechArticle and FAQPage since they were
 * written; the homepage — the page most likely to be cited as "the tool" — had none, so
 * nothing machine-readable said what this is, who runs it, or that it costs nothing.
 *
 * @graph rather than two separate blocks, so the @id references resolve within one
 * document instead of relying on a consumer stitching them together.
 */
const siteSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    /*
     * No Organization node here. The base layout emits it — with Person and WebSite —
     * on every page of the site, and a second definition under the same @id is a second
     * chance to drift: this copy had no `email` and no `founder` the day those were
     * added to the shared one. The application below references it instead.
     */
    {
      '@type': 'SoftwareApplication',
      '@id': absoluteUrl('/#app'),
      // Same spelling as the Organization and the visible header. A near-miss like
      // "notspoofed" beside "notspoofed.com" reads as two things to a resolver.
      name: 'notspoofed.com',
      applicationCategory: 'SecurityApplication',
      operatingSystem: 'Web',
      url: absoluteUrl('/'),
      description:
        'Free SPF, DKIM and DMARC checker that tells you exactly which record to publish to fix email authentication.',
      publisher: { '@id': absoluteUrl('/#organization') },
      // price 0 is the claim worth making machine-readable: "free" in prose is a word
      // every paid tool with a trial also uses.
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      featureList: [
        'SPF check with full include-chain DNS lookup counting',
        'Corrected SPF record generation with minimal flattening',
        'DKIM check across 50 common selectors with signing-key verification',
        'DMARC check including subdomain policy inheritance and report-address authorisation',
        'MTA-STS, TLS-RPT, BIMI and DNSSEC checks',
        'In-browser email header analyzer',
        'Gmail and Yahoo bulk-sender compliance checker',
        'Free JSON API',
      ],
    },
  ],
};

/**
 * Answers first, markup second — never the other way round.
 *
 * Google requires FAQPage markup to correspond to content visible on the page, and marking
 * up answers a reader cannot see is a manual-action risk rather than a clever shortcut. So
 * this array renders the visible section *and* feeds the schema, which makes the two
 * impossible to desynchronise.
 */
const faq = [
  {
    q: 'How do I check if my domain can be spoofed?',
    a: 'Enter your domain above. It reads your public SPF, DKIM and DMARC records and tells you exactly which record to publish to close any gap that lets someone else send mail as your domain.',
  },
  {
    q: 'Is it free, and is there a limit?',
    a: `Free, with no account and no ads. There is one limit and it is technical rather than commercial: ${RATE_LIMIT.MAX_REQUESTS} checks a minute from the same IP address, because each check makes around fifty DNS queries. No paid tier lifts it.`,
  },
  {
    q: 'Do you record the domains I check?',
    a: 'No. A check is a read-only lookup of public DNS records, and the domain is not written down. Pasted email headers never leave your browser at all — the header analyzer parses them locally.',
  },
  {
    q: 'Why does another checker say my DKIM is fine when this one does not?',
    a: 'Usually wildcard DNS. Some domains answer every possible query, so a checker that treats any answer at selector._domainkey as proof will report keys that do not exist. This one verifies each hit is a genuine signing key, and says a miss is not proof DKIM is absent rather than guessing.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<Base
  title="Check your SPF, DKIM and DMARC records — notspoofed.com"
  canonicalPath="/"
>
  {/* is:inline is explicit: these are JSON-LD data blocks, not code to be bundled.
      Without it Astro infers the same thing but warns on every build. */}
  <script type="application/ld+json" is:inline set:html={JSON.stringify(siteSchema)} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <h1>Find out why your email is failing authentication</h1>
  <p class="lede">
    Enter a domain. We read its public DNS records and tell you exactly what to
    publish to fix what's broken — not just that something is.
  </p>

  <DomainForm autofocus={true} />

  <section class="pitch">
    <h2>What this checks</h2>
    <dl>
      <dt>SPF, counted properly</dt>
      <dd>
        SPF permits ten DNS lookups and no more. Past that, receivers give up and
        your record stops working — silently, with no bounce and no warning. We walk
        the whole <code>include:</code> chain, follow <code>redirect=</code>, and
        show you the count. If you're over, we generate a corrected record that
        flattens only the includes it has to. To see the whole tree, or to test a
        draft before you publish it, use the
        <a href="/tools/spf-lookup-counter">SPF lookup counter</a>.
      </dd>

      <dt>DKIM, without inventing selectors</dt>
      <dd>
        Selectors can't be listed from DNS, so every checker guesses. The catch is
        that some domains answer <em>every</em> DNS query, which makes careless tools
        report keys that don't exist. We verify each hit is genuinely a signing key,
        and tell you plainly that a miss isn't proof DKIM is absent.
      </dd>

      <dt>DMARC, including where your reports actually go</dt>
      <dd>
        We check policy inheritance for subdomains, and whether third-party report
        addresses are authorised to receive your data. That last one catches a
        failure most tools miss entirely: a DMARC record that looks perfect while
        the reports go nowhere.
      </dd>
    </dl>

    <h2>Why bother</h2>
    <p>
      Since February 2024, Google and Yahoo require SPF, DKIM and DMARC from anyone
      sending them bulk mail. Domains that don't comply get throttled or rejected,
      and the failure is usually invisible from the sending side — your mail simply
      stops arriving.
    </p>
    <p>
      Authentication is three of the nine things they ask for. The
      <a href="/tools/gmail-yahoo-compliance">Gmail and Yahoo compliance checker</a>
      runs the whole list — and says plainly which requirements no domain-only check
      can confirm, instead of showing a green tick for something it never verified.
    </p>
    <p>
      If a message failed DKIM and you do not know which selector signed it, the{' '}
      <a href="/tools/dkim-selector-finder">DKIM selector finder</a> tests the names every
      major provider publishes and reports the key it finds — including whether it is
      revoked, in testing mode, or too small.
    </p>

    <h2>Our research</h2>
    <p>
      We scanned every company in the Y Combinator directory — 6,157 domains — to see
      how many can be email-spoofed, then did it again three weeks later.
      <a href="/research/yc-email-spoofing-study">60.5% can</a>, and the rate has been
      flat since 2011: a company founded in 2025 is no more protected than one founded
      in 2013. The
      <a href="/research/yc-dmarc-dataset">full dataset</a> is published under CC BY 4.0.
    </p>

    <h2>Already have a failing message?</h2>
    <p>
      The <a href="/headers">header analyzer</a> takes the raw headers from a message
      you received and shows the delivery path, where it was delayed, and why DMARC
      passed or failed — including the case where SPF passes but for the wrong domain,
      which is the reason most "we have SPF" domains still fail. It runs entirely in
      your browser; nothing is uploaded.
    </p>

    <h2>Guides</h2>
    <p>
      If you already know what is broken and want to understand it before you change
      DNS, these start from the problem and end with the record:
    </p>
    <ul class="links">
      {featured.map((guide) => (
        <li><a href={`/guide/${guide.id}`}>{guide.data.title}</a></li>
      ))}
    </ul>
    {guides.length > FEATURED && (
      <p class="more">
        <a href="/guides">All {guides.length} guides</a>
      </p>
    )}

    {/*
      The bounce guides live in the tools application on this same hostname, so nothing
      on this page could link to them and they were reachable only from /tools. They are
      also the best-performing pages the site has — the ones already sitting on page two
      of a search result rather than page nine — which makes a link from the home page
      the single most valuable internal link available.

      Hardcoded rather than generated: this half of the site cannot import the other
      half's knowledge base, and a wrong slug here is a 404 the build cannot catch.
      There is a link check in scripts/check-links.mjs that fetches every one of these.
    */}
    <h2>Why a message bounced</h2>
    <p>
      A bounce quotes an SMTP code and a line of provider text, and the two rarely mean
      the same thing. These decode the ones we see most, each with the fix and who has
      to make it:
    </p>
    <ul class="links">
      {BOUNCE_GUIDES.map((guide) => (
        <li><a href={guide.href}>{guide.title}</a></li>
      ))}
    </ul>
    <p class="more">
      <a href="/tools/bounce-decoder">Decode a bounce you have</a>
    </p>

    <h2>Common questions</h2>
    <dl class="faq">
      {faq.map((item) => (
        <>
          <dt>{item.q}</dt>
          <dd>{item.a}</dd>
        </>
      ))}
    </dl>

    <h2>Try one of these</h2>
    {/* nofollow: these are the only internal links into /check, and each crawl of a
        result page costs ~48 DNS queries for content we do not want indexed. */}
    <ul class="examples">
      <li><a href="/check?domain=lyft.com" rel="nofollow">lyft.com</a> — SPF over the lookup limit</li>
      <li><a href="/check?domain=paypal.com" rel="nofollow">paypal.com</a> — a fully configured domain</li>
      <li><a href="/check?domain=example.com" rel="nofollow">example.com</a> — wildcard DNS that fools other checkers</li>
    </ul>
  </section>
</Base>

<style>
  .pitch { margin-top: 56px; }

  dl { margin: 0; }
  dt {
    font-weight: 600;
    margin-top: 24px;
    font-size: 16px;
  }
  dd {
    margin: 7px 0 0;
    color: var(--muted);
    max-width: 68ch;
  }
  dd code {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1px 5px;
    border-radius: 4px;
  }

  .pitch > p { color: var(--muted); max-width: 68ch; }

  .examples { padding-left: 18px; color: var(--muted); }
  .examples li { margin-bottom: 6px; }

  .links { padding-left: 18px; }
  .links li { margin-bottom: 7px; }

  .more { margin: 12px 0 0; padding-left: 18px; font-size: 15px; }
</style>
