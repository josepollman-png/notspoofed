---
import { siteGraph } from '../lib/schema.js';
import { absoluteUrl } from '../lib/site.js';

interface Props {
  title: string;
  description?: string;
  /** Path to advertise as canonical. Omit on pages that must not be indexed. */
  canonicalPath?: string;
  noindex?: boolean;
  /** Root-relative path to a 1200x630 card. Omit to use the site-wide default. */
  image?: string;
  imageAlt?: string;
  /**
   * Social-card overrides. A `<title>` is written for a search result — it carries the
   * qualifier and the year — while a shared link wants the claim on its own. Most pages
   * are well served by one string for both, so these default to it.
   */
  ogTitle?: string;
  ogDescription?: string;
  ogType?: 'website' | 'article';
}

const {
  title,
  description = 'Free SPF, DKIM and DMARC checker that tells you exactly which record to publish.',
  canonicalPath,
  noindex = false,
  image = '/og-default.png',
  imageAlt = 'notspoofed.com — find out why your email is failing authentication.',
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
} = Astro.props;

const canonical = canonicalPath ? absoluteUrl(canonicalPath) : null;

/* Absolute, because several scrapers (LinkedIn among them) will not resolve a relative
   og:image against the page URL and simply render no card. `absoluteUrl` reads the
   origin at runtime for the reason given in lib/site.ts. */
const imageUrl = absoluteUrl(image);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    {canonical && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {/* Explicit rather than relying on the defaults: Google and Bing both honour these,
        and answer engines that quote a page truncate at max-snippet when one is set. -1
        says the whole page may be quoted, which is the point of publishing it. */}
    {!noindex && <meta name="robots" content="max-snippet:-1, max-image-preview:large" />}

    {/* This tool gets pasted into Slack threads and forum replies. Without these a
        shared link renders as bare text and the free distribution is wasted. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="notspoofed.com" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={imageUrl} />

    {/* SVG first for anything modern, 32px PNG for the browsers that ignore it. Both are
        served from our own origin — the emoji data-URI this replaces rendered as a blank
        square in Safari and in several Windows contexts. */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {/*
      Organization, Person and WebSite, on every page.

      Every article on this site names its author and publisher by @id. Those were
      defined only on / and /about, so on a guide reached straight from a search result
      the references pointed at nodes the crawler had never fetched — a dangling
      reference, not a byline. The nodes are small and identical everywhere, and the
      tools application on this same hostname emits the same two under the same two
      identifiers. scripts/check-jsonld.mjs fails if they ever diverge.
    */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteGraph())} />
    {/* Per-page head additions: a guide advertises its markdown twin here. */}
    <slot name="head" />
    <style is:global>
      :root {
        --bg: #fbfbfa;
        --surface: #ffffff;
        --border: #e4e2dd;
        --text: #1f1e1c;
        --muted: #6b6862;
        --accent: #2f5d50;
        --accent-soft: #e8f0ed;
        --critical: #a3311f;
        --critical-soft: #fbeae7;
        --warning: #8a5a10;
        --warning-soft: #fdf3e3;
        --info: #2b4c73;
        --info-soft: #eaf0f7;
        --pass: #2f6b46;
        --pass-soft: #e9f3ec;
        --radius: 10px;
        --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #16171a;
          --surface: #1e2024;
          --border: #33363d;
          --text: #eceae6;
          --muted: #9a978f;
          --accent: #7fbfa8;
          --accent-soft: #1d2b27;
          --critical: #f08a76;
          --critical-soft: #2e1b18;
          --warning: #e5b56a;
          --warning-soft: #2c2318;
          --info: #8fb4de;
          --info-soft: #1a222c;
          --pass: #86c79c;
          --pass-soft: #17251c;
        }
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, Roboto, sans-serif;
        -webkit-font-smoothing: antialiased;
      }

      .wrap { max-width: 800px; margin: 0 auto; padding: 0 20px; }

      header.site {
        border-bottom: 1px solid var(--border);
        padding: 18px 0;
        margin-bottom: 40px;
      }
      /* Wraps rather than clips. The row used to be nowrap, which meant every item
         added to the nav had to be paid for by shrinking something else — and at five
         items there was nothing left to shrink, so the last link went off the edge.
         Allowing a second line makes the nav additive again. */
      header.site .wrap { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
      header.site a.brand {
        font-weight: 650; color: var(--text); text-decoration: none; font-size: 17px;
      }
      header.site .tag { color: var(--muted); font-size: 13px; }
      header.site nav { margin-left: auto; display: flex; gap: 18px; }
      header.site nav a { color: var(--muted); text-decoration: none; font-size: 14px; }
      header.site nav a:hover { color: var(--text); }

      @media (max-width: 480px) {
        header.site .tag { display: none; }
        /* The wordmark is five characters longer than the nav was laid out for, so it
           still shrinks here — that keeps everything on one line down to about 400px,
           and below that the nav wraps to its own row instead of overflowing. */
        header.site a.brand { font-size: 15px; }
        header.site nav { gap: 14px; }
      }

      h1 { font-size: 30px; line-height: 1.25; margin: 0 0 12px; letter-spacing: -0.02em; }
      h2 { font-size: 20px; margin: 40px 0 14px; letter-spacing: -0.01em; }
      p.lede { color: var(--muted); font-size: 17px; margin: 0 0 28px; }

      code, pre { font-family: var(--mono); font-size: 13px; }

      footer.site {
        margin-top: 72px; padding: 28px 0 48px;
        border-top: 1px solid var(--border);
        color: var(--muted); font-size: 13px;
      }
      footer.site a { color: var(--muted); }
      footer.site .links { margin-top: 14px; }
      footer.site .links a { color: var(--accent); text-decoration: none; }
      footer.site .links a:hover { text-decoration: underline; }

      a { color: var(--accent); }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">notspoofed.com</a>
        <span class="tag">SPF · DKIM · DMARC</span>
        <nav>
          <a href="/headers">Headers</a>
          <a href="/ip">IP</a>
          <a href="/tools">Tools</a>
          {/* Mirrored in the tools app's SiteChrome.tsx; its parity test compares the two. */}
          <a href="/tools/bounce-decoder">Bounces</a>
          <a href="/guides">Guides</a>
          <a href="/api">API</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site">
      <div class="wrap">
        <p>
          {/* "anonymous daily totals" used to be the whole claim here, and it was not
              true — self-hosted analytics also record a per-visit row. Overstating it on
              every page of a site about not being lied to was the wrong trade. */}
          Checks are read-only DNS lookups against public records. No mail is sent, and
          the domains you check are never recorded. No cookies, no third-party scripts,
          no advertising — analytics are self-hosted and
          <a href="/about#what-it-records">described in full</a>.
        </p>
        <p>
          Results are informational. Verify any record against your provider's
          documentation before publishing it — DNS changes affect live mail delivery.
        </p>
        <p class="links">
          <a href="/tools">Tools</a> ·
          <a href="/about">About</a> ·
          <a href="/about#reporting-a-wrong-result">Report a wrong result</a> ·
          <a href="/api">API</a> ·
          {/* A plain anchor, not a badge or embedded star count — those load a
              third-party image and would break the "no external requests" claim
              two paragraphs above. */}
          <a href="https://github.com/josepollman-png/notspoofed">Source on GitHub</a>
        </p>
      </div>
    </footer>
  </body>
</html>
