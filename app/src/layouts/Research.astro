---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';

/**
 * Shared chrome for the research pages.
 *
 * The prose rules mirror the guide template rather than importing from it — Astro's
 * scoped styles do not cross component boundaries, and duplicating ~40 lines of CSS beats
 * making both templates depend on a third file that neither owns.
 *
 * `draft` drives noindex here, and the same flag keeps the page out of the sitemap and
 * llms.txt. The page still resolves so it can be reviewed before its publish date.
 */
interface Props {
  entry: CollectionEntry<'research'>;
  /** JSON-LD graph. Emitted verbatim — the study's was authored against the dataset. */
  schema: unknown;
}

const { entry, schema } = Astro.props;
const { title, titleTag, description, path, draft } = entry.data;
---

<Base
  title={titleTag}
  description={description}
  canonicalPath={path}
  noindex={draft}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  {draft && (
    <p class="draft">
      Draft — not indexed and not linked from the site. Scheduled for release after the
      study.
    </p>
  )}

  <article>
    <h1>{title}</h1>
    <slot />
  </article>
</Base>

<style>
  .draft {
    margin: 0 0 24px;
    padding: 10px 14px;
    border: 1px dashed var(--warning);
    background: var(--warning-soft);
    border-radius: 8px;
    font-size: 14px;
  }

  article :global(h2) { font-size: 21px; margin: 36px 0 12px; }
  article :global(h3) { font-size: 17px; margin: 28px 0 8px; }
  article :global(p), article :global(li) { max-width: 68ch; }
  article :global(p) { margin: 0 0 16px; }
  article :global(ul), article :global(ol) { padding-left: 22px; }
  article :global(li) { margin-bottom: 8px; }

  article :global(pre) {
    padding: 14px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow-x: auto;
    line-height: 1.6;
  }
  article :global(code) {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 1px 5px;
    border-radius: 4px;
  }
  article :global(pre code) { background: none; border: 0; padding: 0; }

  article :global(blockquote) {
    margin: 20px 0;
    padding: 12px 16px;
    border-left: 3px solid var(--accent);
    background: var(--accent-soft);
    border-radius: 0 8px 8px 0;
  }
  article :global(blockquote p:last-child) { margin-bottom: 0; }

  /* Wide data tables: scroll the table, never the page. */
  article :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 20px 0;
    font-size: 15px;
    display: block;
    overflow-x: auto;
  }
  article :global(th), article :global(td) {
    text-align: left;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border);
  }
  article :global(th) { font-weight: 600; }
  /* Markdown right-aligns numeric columns with |---:| and that alignment carries meaning
     in these tables — it is how the counts line up against the percentages. */
  article :global(th[align='right']), article :global(td[align='right']) { text-align: right; }
  article :global(td) { font-variant-numeric: tabular-nums; }

  article :global(hr) {
    margin: 40px 0 24px;
    border: 0;
    border-top: 1px solid var(--border);
  }
</style>
