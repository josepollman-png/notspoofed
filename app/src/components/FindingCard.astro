---
import type { Finding } from '../lib/findings.js';
import { guideFor, guideHref } from '../lib/guide-links.js';

interface Props { finding: Finding }
const { finding } = Astro.props;

const guide = guideFor(finding.id);

const LABEL: Record<Finding['severity'], string> = {
  critical: 'Critical',
  warning: 'Warning',
  info: 'Note',
  pass: 'Good',
};
---

<article class:list={['finding', finding.severity]}>
  <div class="head">
    <span class="badge">{LABEL[finding.severity]}</span>
    <h3>{finding.title}</h3>
  </div>

  <p class="detail">{finding.detail}</p>

  {finding.fix?.kind === 'record' && (
    <div class="fix">
      <div class="fix-label">
        Publish this <strong>{finding.fix.type}</strong> record at
        <code>{finding.fix.host}</code>
      </div>
      <div class="record">
        <pre data-copy-source>{finding.fix.value}</pre>
        <button type="button" class="copy" data-copy>Copy</button>
      </div>
      {finding.fix.caveat && (
        <p class="caveat"><strong>Before you publish:</strong> {finding.fix.caveat}</p>
      )}
    </div>
  )}

  {finding.fix?.kind === 'action' && (
    <div class="fix">
      <div class="fix-label">What to do</div>
      <ol class="steps">
        {finding.fix.steps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  )}

  {/* Last, so it never pushes the copyable record further down the card. */}
  {guide && (
    <p class="guide">
      <a href={guideHref(guide)}>Read: {guide.title}</a>
    </p>
  )}
</article>

<style>
  .finding {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 20px;
    margin-bottom: 14px;
  }
  .finding.critical { border-left-color: var(--critical); }
  .finding.warning  { border-left-color: var(--warning); }
  .finding.info     { border-left-color: var(--info); }
  .finding.pass     { border-left-color: var(--pass); }

  .head { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; }

  .badge {
    font-size: 11px;
    font-weight: 650;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 3px 8px;
    border-radius: 20px;
    white-space: nowrap;
  }
  .critical .badge { color: var(--critical); background: var(--critical-soft); }
  .warning  .badge { color: var(--warning);  background: var(--warning-soft); }
  .info     .badge { color: var(--info);     background: var(--info-soft); }
  .pass     .badge { color: var(--pass);     background: var(--pass-soft); }

  h3 { font-size: 16px; margin: 0; font-weight: 600; letter-spacing: -0.01em; }

  .detail { margin: 10px 0 0; color: var(--muted); font-size: 15px; max-width: 68ch; }

  .fix { margin-top: 16px; padding-top: 14px; border-top: 1px dashed var(--border); }
  .fix-label { font-size: 13px; color: var(--muted); margin-bottom: 8px; }
  .fix-label code {
    color: var(--text);
    background: var(--bg);
    padding: 1px 5px;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  .record { position: relative; }
  .record pre {
    margin: 0;
    padding: 13px 66px 13px 14px;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    /* Long records must scroll inside the box, never widen the page. */
    overflow-x: auto;
    white-space: pre-wrap;
    word-break: break-all;
    line-height: 1.55;
  }

  .copy {
    position: absolute;
    top: 8px;
    right: 8px;
    padding: 5px 11px;
    font-size: 12px;
    font-family: inherit;
    font-weight: 550;
    color: var(--muted);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
  }
  .copy:hover { color: var(--text); }
  .copy[data-copied] { color: var(--pass); border-color: var(--pass); }

  .guide { margin: 14px 0 0; font-size: 14px; }
  .guide a { color: var(--accent); text-decoration: none; }
  .guide a:hover { text-decoration: underline; }

  .caveat {
    margin: 12px 0 0;
    padding: 11px 13px;
    font-size: 14px;
    background: var(--warning-soft);
    color: var(--text);
    border-radius: 8px;
    max-width: 68ch;
  }
  .caveat strong { color: var(--warning); }

  .steps { margin: 0; padding-left: 20px; font-size: 15px; color: var(--muted); }
  .steps li { margin-bottom: 7px; max-width: 66ch; }
</style>
